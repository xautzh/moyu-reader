{
  "name": "moyu-reader",
  "version": "2.0.1",
  "description": "墨阅：支持所见即所得、源码与实时预览的桌面 Markdown 编辑器。",
  "main": "./out/main/index.js",
  "author": "墨阅",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src scripts electron-vite.config.ts vitest.config.ts",
    "build": "npm run typecheck && npm run test && electron-vite build",
    "icons": "node scripts/generate-icon.mjs",
    "qa:electron": "node scripts/smoke-electron.mjs",
    "dist:win": "npm run icons && npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run icons && npm run build && electron-builder --mac --publish never && node scripts/alias-mac-artifacts.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/kit": "^7.22.1",
    "@uiw/react-codemirror": "^4.25.11",
    "electron-updater": "^6.8.9",
    "github-slugger": "^2.0.0",
    "katex": "^0.18.5",
    "lucide-react": "^1.38.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.17.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@swc/core": "^1.16.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.moyu.reader",
    "productName": "墨阅",
    "copyright": "Copyright © 2026 墨阅",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xautzh",
        "repo": "moyu-reader"
      }
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "墨阅",
      "artifactName": "Moyu-${version}-Windows.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "Moyu-${version}-macOS-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "墨阅",
      "uninstallDisplayName": "墨阅"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown 文档",
        "description": "Markdown 文档",
        "role": "Editor"
      }
    ]
  }
}
