{
  "name": "moyu-reader",
  "version": "1.0.0",
  "description": "墨阅：专注、克制的 Windows Markdown 阅读器。",
  "main": "./out/main/index.js",
  "author": "Moyu Reader",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src scripts electron-vite.config.ts vitest.config.ts",
    "build": "npm run typecheck && npm run test && electron-vite build",
    "icons": "node scripts/generate-icon.mjs",
    "qa:electron": "node scripts/smoke-electron.mjs",
    "dist:win": "npm run icons && npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.38.0",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@swc/core": "^1.16.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.moyu.reader",
    "productName": "墨阅 Markdown 阅读器",
    "copyright": "Copyright © 2026 Moyu Reader",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "MoyuReader",
      "artifactName": "MoyuReader-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "墨阅 Markdown 阅读器",
      "uninstallDisplayName": "墨阅 Markdown 阅读器"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown 文档",
        "description": "Markdown 文档",
        "role": "Viewer"
      }
    ]
  }
}
